#!/usr/bin/env bash

echo "Starting code-server script..."

# 1. Purge modules and maintain system PATH
module purge 2>/dev/null
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"

# 2. Load miniforge and source Conda
module load miniforge3 2>/dev/null || true
source /mnt/apps/manual/miniforge3/25.3.1-0_gcc-11.4.1/etc/profile.d/conda.sh

# 3. Define dynamic environment path per user
ENV_PATH="/work/${USER}/.conda/envs/codeserver_env"

# Verify environment exists
if [ ! -d "${ENV_PATH}" ]; then
    echo "ERROR: Environment ${ENV_PATH} does not exist!"
    echo "Please create it on the login node first using:"
    echo "  export CONDA_PKGS_DIRS=\"/work/\${USER}/.conda/pkgs\""
    echo "  export TMPDIR=\"/work/\${USER}/tmp\""
    echo "  conda create --prefix /work/\${USER}/.conda/envs/codeserver_env -c conda-forge code-server -y"
    exit 1
fi

# 4. Activate dedicated code-server environment
echo "Activating Conda env at ${ENV_PATH}..."
conda activate "${ENV_PATH}"

export PATH="${ENV_PATH}/bin:${PATH}"

# 5. Verify executable
if ! command -v code-server &> /dev/null; then
    echo "ERROR: 'code-server' binary not found after activation."
    exit 1
fi

# 6. Set working directory
export WORKING_DIR="<%= context.working_dir.blank? ? $HOME : context.working_dir %>"
cd "${WORKING_DIR}"

# 7. Set authentication and launch
export PASSWORD="${password}"
export DISABLE_TELEMETRY="true"
export DISABLE_UPDATE_CHECK="true"

# Redirect runtime sockets away from system /run/user
export XDG_RUNTIME_DIR="/tmp/runtime-${USER}"
mkdir -p -m 700 "${XDG_RUNTIME_DIR}"

set -x
exec code-server \
  --auth="none" \
  --bind-addr="0.0.0.0:${port}" \
  --disable-telemetry \
  --disable-update-check \
  --user-data-dir="${HOME}/.local/share/code-server" \
  --extensions-dir="${HOME}/.local/share/code-server/extensions" \
  "${WORKING_DIR}"
