<%-
  user = ENV['USER']
  env_path = "/work/#{user}/.conda/envs/codeserver_env"
  conda_bin = "/mnt/apps/manual/miniforge3/25.3.1-0_gcc-11.4.1/bin/conda"

  # If environment doesn't exist, create it directly using the conda binary
  unless Dir.exist?(env_path)
    pkgs_dir = "/work/#{user}/.conda/pkgs"
    tmp_dir = "/work/#{user}/tmp"
    
    # 1. Create cache folders
    system("mkdir -p '#{pkgs_dir}' '#{tmp_dir}'")
    
    # 2. Run conda create directly without needing 'module load'
    build_cmd = "CONDA_PKGS_DIRS='#{pkgs_dir}' TMPDIR='#{tmp_dir}' #{conda_bin} create --prefix '#{env_path}' -c conda-forge code-server -y"
    
    # Execute command synchronously on the web host
    system(build_cmd)
  end
  -%>
---
batch_connect:
  template: "basic"
  conn_params:
    - code_server_version
script:
  native:
    - "--job-name"
    - "<%= bc_job_name %>"
